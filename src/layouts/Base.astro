---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/instrument-sans";
import "@fontsource/fragment-mono";
import "../styles/tokens.css";
import "../styles/base.css";
import { identity } from "../data/research";
import { absolute, PERSON_ID, WEBSITE_ID, SITE_NAME } from "../data/seo";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Site-relative path of a 1200x630 PNG. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Page-specific schema.org nodes, merged with Person and WebSite into one @graph. */
  jsonLd?: Record<string, unknown>[];
  citationTitle?: string;
  citationAuthors?: string[];
  citationDate?: string;
}

const {
  title,
  description,
  noindex = false,
  ogImage = "/og.png",
  ogImageAlt = "Rajveer Singh Pall, AI Research: testing whether machine learning results mean what they claim",
  ogType = "website",
  jsonLd = [],
  citationTitle,
  citationAuthors,
  citationDate,
} = Astro.props;

const canonical = absolute(Astro.url.pathname);
const ogImageUrl = absolute(ogImage);

const person = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: identity.name,
  url: absolute("/"),
  jobTitle: "AI Researcher",
  description:
    "AI researcher studying whether machine learning results mean what they claim: benchmark evaluation, fairness at the decision threshold, and external validation.",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Gyan Ganga Institute of Technology and Sciences",
  },
  knowsAbout: [
    "Machine learning evaluation",
    "Partial identification",
    "Algorithmic fairness",
    "External validation",
    "Distribution shift",
  ],
  email: `mailto:${identity.email}`,
  sameAs: identity.links.map((l) => l.href),
};

const website = {
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  url: absolute("/"),
  name: SITE_NAME,
  inLanguage: "en",
  author: { "@id": PERSON_ID },
};

// `<` is escaped so no string in the data can close the script element.
const graph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [person, website, ...jsonLd],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content="rXaFWWr31Bx8XONqpWOKwkLsFHxPo53jyEosuBKAXqQ" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {citationTitle && <meta name="citation_title" content={citationTitle} />}
    {citationAuthors && citationAuthors.map((a) => <meta name="citation_author" content={a} />)}
    {citationDate && <meta name="citation_publication_date" content={citationDate} />}
    {citationTitle && <meta name="citation_abstract_html_url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === "article" && <meta property="article:author" content={absolute("/")} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={graph} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="site-field" id="site-field" aria-hidden="true" transition:persist
    ></canvas>
    <slot />
    <script>
      import { initMotion, cleanupMotion } from "../scripts/motion";
      // run now (astro:page-load may already have fired in dev) and after
      // every view transition; initMotion cleans up before re-running
      initMotion();
      document.addEventListener("astro:page-load", initMotion);
      document.addEventListener("astro:before-swap", cleanupMotion);
    </script>
  </body>
</html>
