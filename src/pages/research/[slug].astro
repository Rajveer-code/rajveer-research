---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import MethodFlow from "../../components/MethodFlow.astro";
import FigureBars from "../../components/FigureBars.astro";
import PaperFigures from "../../components/PaperFigures.astro";
import HeroFigure from "../../components/HeroFigure.astro";
import {
  publications,
  THEME_LABELS,
  STATUS_CITATION_NOTE,
  DISCOVERY,
  type Publication,
} from "../../data/research";

export function getStaticPaths() {
  return publications.map((p) => ({ params: { slug: p.slug }, props: { pub: p } }));
}

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const discovery = DISCOVERY[pub.slug];
const hasMethod = Boolean(pub.approach) || pub.flow.length > 0;
const hasResults = Boolean(pub.findings) || pub.figures.length > 0 || pub.results.length > 0;
const hasFigures = (pub.paperFigures?.length ?? 0) > 0;

const jump = [
  discovery && { href: "#figure", label: "Discovery" },
  { href: "#summary", label: "5 minutes" },
  { href: "#question", label: "Question" },
  hasMethod && { href: "#method", label: "Method" },
  hasResults && { href: "#results", label: "Results" },
  pub.matters && { href: "#takeaways", label: "Takeaways" },
  { href: "#resources", label: "Resources" },
].filter(Boolean) as { href: string; label: string }[];

// Related work: most shared themes first, then reading order.
const shared = (p: Publication) => p.themes.filter((t) => pub.themes.includes(t)).length;
const related = publications
  .filter((p) => p.slug !== pub.slug && shared(p) > 0)
  .sort((a, b) => shared(b) - shared(a) || a.order - b.order)
  .slice(0, 3);

// Scholar-style citation tags only for work that is public in its final or working form.
const citable = pub.statusKind === "published" || pub.statusKind === "working";
---

<Base
  title={`${pub.shortTitle} · Rajveer Singh Pall`}
  description={pub.oneLiner}
  citationTitle={citable ? pub.title : undefined}
  citationAuthors={citable ? pub.authors.split(", ") : undefined}
  citationDate={citable ? pub.year : undefined}
>
  <Nav />
  <main id="main" tabindex="-1">
    <article>
      <header class="paper-head container">
        <p class="label-mono breadcrumb">
          <a href="/#publications">Publications</a> / {pub.shortTitle}
        </p>
        <div class="paper-meta">
          <span class={`status status--${pub.statusKind}`}>{pub.status}</span>
          <span class="label-mono">{pub.year}</span>
        </div>
        <h1 class="paper-title" data-hero="1">{pub.title}</h1>
        <p class="paper-authors ui-sans" data-hero="2">{pub.authors}</p>
        <p class="paper-oneliner" data-hero="3">{pub.oneLiner}</p>
        {
          pub.links.length > 0 && (
            <div class="paper-links ui-sans" data-hero="4">
              {pub.links.map((l) => (
                <a class="btn" href={l.href}>
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </header>

      <nav class="paper-jump" aria-label="On this page" data-paper-jump>
        <div class="container paper-jump-inner ui-sans">
          {jump.map((j) => <a href={j.href}>{j.label}</a>)}
        </div>
      </nav>

      {/* 2 · Discovery in one image */}
      {
        discovery && (
          <section class="onefig container" id="figure" aria-label="The discovery in one figure">
            <p class="label-mono section-eyebrow" data-reveal>The discovery in one figure</p>
            <div data-reveal>
              <HeroFigure slug={pub.slug} caption={discovery} />
            </div>
          </section>
        )
      }

      {/* 3 · Read in five minutes */}
      <section class="fivemin container" id="summary" aria-label="The paper in five minutes">
        <p class="label-mono section-eyebrow" data-reveal>The paper in five minutes</p>
        <p class="lead-text" data-reveal>{pub.plain}</p>
      </section>

      {/* 4 · Research question */}
      <section class="question container" id="question" aria-label="The research question">
        <p class="label-mono section-eyebrow" data-reveal>The research question</p>
        <p class="lead-text" data-reveal>{pub.problem}</p>
      </section>

      {/* 5 · Methodology */}
      {
        hasMethod && (
          <section class="method container" id="method" aria-label="How it works">
            <p class="label-mono section-eyebrow" data-reveal>How it works</p>
            <div class="method-grid" data-reveal>
              {pub.approach && <p class="body-text method-lead">{pub.approach}</p>}
              {pub.flow.length > 0 && <MethodFlow steps={pub.flow} />}
            </div>
          </section>
        )
      }

      {/* 6 · Experimental results (evidence: data + metrics) */}
      {
        hasResults && (
          <section class="results container" id="results" aria-label="Experimental results">
            <p class="label-mono section-eyebrow" data-reveal>Experimental results</p>
            {pub.findings && <p class="body-text" data-reveal>{pub.findings}</p>}
            {pub.figures.length > 0 && (
              <div class="result-figs" data-reveal>
                {pub.figures.map((f) => (
                  <FigureBars figure={f} />
                ))}
              </div>
            )}
            {pub.results.length > 0 && (
              <ul class="results-grid" data-reveal>
                {pub.results.map((r) => (
                  <li>
                    <span class="result-value">{r.value}</span>
                    <span class="result-label">{r.label}</span>
                  </li>
                ))}
              </ul>
            )}
            {pub.caveat && (
              <p class="caveat" data-reveal>
                <span class="label-mono caveat-tag">Stated honestly</span>
                {pub.caveat}
              </p>
            )}
          </section>
        )
      }

      {hasFigures && <PaperFigures slug={pub.slug} figures={pub.paperFigures!} />}

      {/* 7 · What this changes */}
      {
        pub.matters && (
          <section class="takeaways container" id="takeaways" aria-label="What this changes">
            <p class="label-mono section-eyebrow" data-reveal>What this changes</p>
            <p class="lead-text" data-reveal>{pub.matters}</p>
          </section>
        )
      }

      {/* 8 · Resources & citation */}
      <section class="resources container" id="resources" data-reveal aria-label="Resources and citation">
        <div class="cite-grid">
          <div>
            <p class="label-mono section-eyebrow">Resources</p>
            {
              pub.links.length > 0 && (
                <div class="resource-links ui-sans">
                  {pub.links.map((l) => (
                    <a class="btn" href={l.href}>{l.label} ↗</a>
                  ))}
                </div>
              )
            }
            {
              pub.absent && (
                <p class="absent">
                  <span class="label-mono absent-tag">Not public yet</span>
                  {pub.absent}
                </p>
              )
            }
            <ul class="theme-list" aria-label="Themes">
              {pub.themes.map((t) => <li class="label-mono">{THEME_LABELS[t]}</li>)}
            </ul>
          </div>
          <div>
            <p class="label-mono section-eyebrow">Citation</p>
            {
              pub.citation && (
                <div class="cite-block" data-cite>
                  <p class="cite-text" data-cite-text>{pub.citation}</p>
                  <button type="button" class="cite-copy ui-sans" data-cite-copy>
                    Copy citation
                  </button>
                  <span class="label-mono cite-status" aria-live="polite" data-cite-status></span>
                </div>
              )
            }
            <p class="cite-note">
              {STATUS_CITATION_NOTE[pub.statusKind]} Reach me at{" "}
              <a href="mailto:rajveerpall04@gmail.com" translate="no">rajveerpall04@gmail.com</a>.
            </p>
          </div>
        </div>
      </section>

      {/* 9 · Related research */}
      {
        related.length > 0 && (
          <section class="related container" data-reveal aria-label="Related research">
            <p class="label-mono section-eyebrow">Where this leads next</p>
            <ul class="related-list">
              {related.map((r) => (
                <li>
                  <a href={`/research/${r.slug}/`} class="related-link">
                    <span class="related-title">{r.shortTitle}</span>
                    <span class={`status status--${r.statusKind}`}>{r.status}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <a class="label-mono back" href="/#publications">← All publications</a>
      <span class="label-mono">© 2026 Rajveer Singh Pall</span>
    </div>
  </footer>
</Base>

<script>
  function initPaperJump() {
    const nav = document.querySelector("[data-paper-jump]");
    if (!nav) return;
    const links = [...nav.querySelectorAll("a")];
    const byId = new Map(
      links.map((a) => [a.getAttribute("href")!.slice(1), a]),
    );
    const sections = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    if (!sections.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove("is-active"));
            byId.get((e.target as HTMLElement).id)?.classList.add("is-active");
          }
        });
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }

  function initCiteCopy() {
    document.querySelectorAll<HTMLElement>("[data-cite]").forEach((block) => {
      if (block.dataset.wired) return;
      block.dataset.wired = "1";
      const button = block.querySelector<HTMLButtonElement>("[data-cite-copy]")!;
      const status = block.querySelector<HTMLElement>("[data-cite-status]")!;
      const text = block.querySelector<HTMLElement>("[data-cite-text]")!.textContent ?? "";
      if (!navigator.clipboard) {
        button.hidden = true; // text stays selectable
        return;
      }
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text.trim());
          status.textContent = "Copied";
        } catch {
          status.textContent = "Select the text to copy it";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", () => {
    initPaperJump();
    initCiteCopy();
  });
</script>

<style>
  /* sticky in-page jump nav: helps professors skim */
  .paper-jump {
    position: sticky;
    top: 0;
    z-index: 95;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--rule);
  }
  .paper-jump-inner {
    display: flex;
    gap: var(--space-6);
    padding-block: var(--space-3);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .paper-jump-inner::-webkit-scrollbar { display: none; }
  .paper-jump a {
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .paper-jump a:hover { color: var(--signal); }
  .paper-jump a.is-active { color: var(--signal); font-weight: 600; }

  /* anchor targets clear both sticky bars */
  #figure, #summary, #question, #method, #results, #takeaways, #resources { scroll-margin-top: 6rem; }

  .paper-head {
    padding-block: var(--space-24) var(--space-16);
    border-bottom: var(--rule);
  }

  .breadcrumb { display: block; margin-bottom: var(--space-12); }
  .breadcrumb a { color: var(--ink-3); text-decoration: none; }
  .breadcrumb a:hover { color: var(--signal); }

  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: baseline;
    margin-bottom: var(--space-6);
  }

  .paper-title {
    font-size: var(--text-xl);
    font-weight: 460;
    max-width: 30ch;
    margin-bottom: var(--space-6);
  }

  .paper-authors { color: var(--ink-3); margin-bottom: var(--space-4); }

  .paper-oneliner {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .paper-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-2);
    color: var(--ink);
    text-decoration: none;
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .btn:hover { border-color: var(--signal); color: var(--signal); }

  .section-eyebrow {
    color: var(--signal);
    display: block;
    margin-bottom: var(--space-8);
  }

  /* shared reading text, sized for a 13 to 15 inch laptop at about 1 m */
  .lead-text {
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--ink);
    max-width: 60ch;
  }

  .body-text {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--ink);
    max-width: 62ch;
  }

  .onefig {
    padding-block: var(--space-16) var(--space-24);
    border-bottom: var(--rule);
  }

  .onefig > div { max-width: 62rem; }

  /* 3 · five minutes: highlighted panel */
  .fivemin { padding-block: var(--space-24); border-bottom: var(--rule); }

  .fivemin .lead-text {
    padding: var(--space-8);
    background: var(--paper-recessed);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    max-width: 66ch;
  }

  /* 4 · research question */
  .question { padding-block: var(--space-24); border-bottom: var(--rule); }

  /* 5 · methodology */
  .method { padding-block: var(--space-24); border-bottom: var(--rule); }

  .method-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-12);
    align-items: start;
  }

  .method-lead { max-width: none; }

  @media (max-width: 860px) {
    .method-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  /* 7 · takeaways */
  .takeaways { padding-block: var(--space-24); border-bottom: var(--rule); }

  /* 8 · resources */
  .resources { padding-block: var(--space-24); border-bottom: var(--rule); }

  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .absent {
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-6);
    background: var(--paper-recessed);
    border-left: 2px solid var(--hairline-strong);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .absent-tag { display: block; margin-bottom: var(--space-2); }

  .results { padding-block: var(--space-24); border-bottom: var(--rule); }

  .results .body-text { margin-bottom: var(--space-12); }

  .result-figs {
    display: grid;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .results-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-6);
  }

  .results-grid li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    background: var(--paper-raised);
  }

  .result-value {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--signal);
    letter-spacing: -0.02em;
  }

  .result-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .caveat {
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-6);
    background: var(--paper-recessed);
    border-left: 2px solid var(--hairline-strong);
    color: var(--ink-2);
    max-width: 70ch;
  }

  .caveat-tag { display: block; margin-bottom: var(--space-2); }

  .cite-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }

  .theme-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .cite-block {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-6);
    background: var(--paper-raised);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
  }

  .cite-text {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .cite-copy {
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--ink);
    touch-action: manipulation;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .cite-copy:hover { border-color: var(--signal); color: var(--signal); }

  .cite-status { color: var(--verified); min-height: 1.4em; }

  .cite-note { color: var(--ink-2); }

  .related { padding-block: var(--space-24); }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .related-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .related-link:hover .related-title { color: var(--signal); }

  .related-title {
    font-size: var(--text-md);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .related-link .status { flex-shrink: 0; }

  .footer {
    border-top: var(--rule);
    background: var(--paper-recessed);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .back { color: var(--signal); text-decoration: none; }

  @media (max-width: 720px) {
    .cite-grid { grid-template-columns: 1fr; gap: var(--space-12); }
    .related-link { flex-direction: column; gap: var(--space-2); }
  }
</style>
