---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";
import Vision from "../components/Vision.astro";
import Flagship from "../components/Flagship.astro";
import Timeline from "../components/Timeline.astro";
import ResearchMap from "../components/ResearchMap.astro";
import Publications from "../components/Publications.astro";
import OpenScience from "../components/OpenScience.astro";
import Impact from "../components/Impact.astro";
import FutureVision from "../components/FutureVision.astro";
import News from "../components/News.astro";
import Contact from "../components/Contact.astro";
import { absolute, PERSON_ID, WEBSITE_ID } from "../data/seo";

const title = "Rajveer Singh Pall · Trustworthy Machine Learning Research";
const description =
  "Rajveer Singh Pall is an AI researcher testing whether machine learning results mean what they claim: LLM benchmarks, fairness and clinical validation.";

const profilePage = {
  "@type": "ProfilePage",
  "@id": absolute("/#profile"),
  url: absolute("/"),
  name: title,
  description,
  inLanguage: "en",
  mainEntity: { "@id": PERSON_ID },
  isPartOf: { "@id": WEBSITE_ID },
};
---

<Base title={title} description={description} jsonLd={[profilePage]}>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <Highlights />
    <Vision />
    <Flagship />
    <Timeline />
    <ResearchMap />
    <Publications />
    <OpenScience />
    <Impact />
    <FutureVision />
    <News />
    <Contact />
  </main>
</Base>
