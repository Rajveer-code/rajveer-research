  .hf :global(.arrow) { stroke: var(--hairline-strong); stroke-width: 1.5; fill: none; }

  .hf :global(.cell) { fill: var(--paper-recessed); stroke: var(--hairline-strong); stroke-width: 0.6; }
  .hf :global(.cell-open) { fill: var(--paper-raised); stroke: var(--signal); stroke-width: 1.5; }
  .hf :global(.cell-on) { fill: var(--signal); }
  .hf :global(.cell-bad) { fill: var(--alert); }

  .hf :global(.sev-bad) { fill: var(--alert); }
  .hf :global(.sev-warn) { fill: var(--signal); }
  .hf :global(.sev-mild) { fill: var(--ink-3); }
  .hf :global(.sev-info) { fill: var(--hairline-strong); }

  .hf :global(.dist-fill) { fill: var(--signal-wash); }
  .hf :global(.dist-pen) { fill: color-mix(in srgb, var(--signal) 26%, transparent); }
</style>
