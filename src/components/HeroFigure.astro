---
/**
 * Discovery-first figure: one image per paper, each with its own visual
 * grammar, answering "what did this paper find?" in one look. Every annotated
 * number is verified against the paper's current source (see research.ts);
 * where a shape is schematic the figure says so. On-brand SVG, token colours.
 */
import data from "../data/leaderboard.json";

interface Props {
  slug: string;
  caption: string;
}
const { slug, caption } = Astro.props;

const f2 = (x: number) => x.toFixed(1);

/* ---- benchmark-accuracy-not-identified: three top rows + the 378-pair triangle ---- */
const boardTop = data.models.slice(0, 3);
const bx = (v: number) => 52 + v * 100 * 3.5; // 0 to 80% across 280px
const overlapLo = Math.max(...boardTop.map((m) => m.lower));
const overlapHi = Math.min(...boardTop.map((m) => m.upper));
const cells: { x: number; y: number; on: boolean }[] = [];
data.models.forEach((a, i) => {
  data.models.forEach((b, j) => {
    if (j <= i) return;
    cells.push({ x: 404 + (j - 1) * 10, y: 60 + i * 10, on: !a.inseparable.includes(b.order) });
  });
});
const identifiedPairs = cells.filter((c) => c.on).length;

/* ---- confidently-wrong: 240 evaluations, 108 below chance ---- */
const evals = Array.from({ length: 240 }, (_, k) => ({
  x: 40 + (k % 60) * 10,
  y: 250 + Math.floor(k / 60) * 10,
  bad: k < 108,
}));
const ax = (auc: number) => 40 + auc * 640;
---

{
  caption && (
    <figure class="hf">
      <div class="hf-frame">
        {/* ============ BENCHMARK ACCURACY: reported ranks vs identified ranges ============ */}
        {slug === "benchmark-accuracy-not-identified" && (
          <svg class="hf-svg" viewBox="0 0 720 400" role="img" aria-label={`The top three MATH-Hard models have overlapping identified ranges; ${identifiedPairs} of ${data.counts.pairs} pairwise orderings are identified and ${data.counts.notIdentified} are not.`}>
            <text x="24" y="34" class="eyebrow">THE TOP THREE, AS PUBLISHED AND AS IDENTIFIED</text>
            <rect x={bx(overlapLo)} y="56" width={bx(overlapHi) - bx(overlapLo)} height="150" class="fill-swash" />
            {boardTop.map((m, i) => {
              const y = 84 + i * 50;
              return (
                <g>
                  <text x="24" y={y} class="mono mini fill-signal-t">#{m.reportedRank}</text>
                  <text x="52" y={y} class="mini">{m.name}</text>
                  <text x="332" y={y} class="mono tiny muted" text-anchor="end">{f2(m.score * 100)}%</text>
                  <line x1={bx(m.lower)} y1={y + 16} x2={bx(m.upper)} y2={y + 16} class="stroke-ink" stroke-width="2" />
                  <line x1={bx(m.lower)} y1={y + 11} x2={bx(m.lower)} y2={y + 21} class="stroke-ink" stroke-width="1.5" />
                  <line x1={bx(m.upper)} y1={y + 11} x2={bx(m.upper)} y2={y + 21} class="stroke-ink" stroke-width="1.5" />
                  <circle cx={bx(m.score)} cy={y + 16} r="4.5" class="fill-signal stroke-raised" stroke-width="2" />
                </g>
              );
            })}
            <line x1="52" y1="222" x2="332" y2="222" class="stroke-hairS" />
            {[0, 20, 40, 60, 80].map((t) => (
              <g>
                <line x1={52 + t * 3.5} y1="218" x2={52 + t * 3.5} y2="226" class="stroke-hairS" />
                <text x={52 + t * 3.5} y="240" class="mono tiny muted" text-anchor="middle">{t}%</text>
              </g>
            ))}
            <text x="24" y="266" class="small">Shaded: the accuracy all three ranges share,</text>
            <text x="24" y="284" class="small">so no ordering of the three is identified.</text>
            <text x="24" y="330" class="big-num fill-signal-t">{data.counts.notIdentified} / {data.counts.pairs}</text>
            <text x="24" y="354" class="small">orderings not identified with human-audited margins</text>
            <text x="24" y="374" class="small muted">{data.counts.notIdentifiedAtZeroError} of {data.counts.pairs} even at zero scorer error</text>

            <text x="404" y="34" class="eyebrow">ALL {data.counts.pairs} PAIRWISE ORDERINGS</text>
            {cells.map((c) => (
              <rect x={c.x} y={c.y} width="8" height="8" class={c.on ? "cell-on" : "cell"} />
            ))}
            <rect x="404" y="346" width="10" height="10" class="cell-on" />
            <text x="420" y="355" class="mini">{identifiedPairs} identified</text>
            <rect x="524" y="346" width="10" height="10" class="cell" />
            <text x="540" y="355" class="mini">{data.counts.notIdentified} not identified</text>
            <text x="404" y="378" class="tiny muted">Rows and columns: the {data.models.length} models in published rank order.</text>
          </svg>
        )}

        {/* ============ SUBGROUP FAIRNESS REVERSAL: the audit improves, the decision worsens ============ */}
        {slug === "subgroup-fairness-reversal" && (
          <svg class="hf-svg" viewBox="0 0 720 380" role="img" aria-label="The White-Black AUC gap narrows from 0.0075 to 0.0005 under FedAvg, while the sensitivity gap at fixed screening capacity widens from 0.009 to 0.034.">
            <text x="24" y="34" class="eyebrow">THE AUDIT · WHITE-BLACK AUC GAP</text>
            <text x="24" y="72" class="mini">Centralised control</text>
            <rect x="24" y="80" width={0.0075 / 0.01 * 300} height="22" rx="2" class="fill-hairS" />
            <text x={24 + 0.0075 / 0.01 * 300 + 10} y="96" class="mono mini">0.0075</text>
            <text x="24" y="132" class="mini">FedAvg</text>
            <rect x="24" y="140" width={0.0005 / 0.01 * 300} height="22" rx="2" class="fill-verified" />
            <text x={24 + 0.0005 / 0.01 * 300 + 10} y="156" class="mono mini">0.0005</text>
            <text x="24" y="196" class="mini fill-verified-t">Gap narrows: the audit looks fairer</text>

            <line x1="360" y1="20" x2="360" y2="206" class="stroke-hair" stroke-dasharray="3 4" />

            <text x="384" y="34" class="eyebrow">THE DECISION · SENSITIVITY GAP</text>
            <text x="384" y="50" class="tiny muted">race-blind screening at fixed capacity</text>
            <text x="384" y="72" class="mini">Centralised control</text>
            <rect x="384" y="80" width={0.009 / 0.04 * 300} height="22" rx="2" class="fill-hairS" />
            <text x={384 + 0.009 / 0.04 * 300 + 10} y="96" class="mono mini">0.009</text>
            <text x="384" y="132" class="mini">FedAvg</text>
            <rect x="384" y="140" width={0.034 / 0.04 * 300} height="22" rx="2" class="fill-bad" />
            <text x={384 + 0.034 / 0.04 * 300 - 8} y="156" class="mono mini fill-paper-t" text-anchor="end">0.034</text>
            <text x="384" y="196" class="mini fill-bad-t">Gap widens: fewer Black respondents flagged</text>

            <rect x="24" y="236" width="672" height="120" rx="8" class="fill-recessed" />
            <text x="48" y="304" class="big-num fill-bad-t">542</text>
            <text x="126" y="288" class="lbl">fewer reference-positive Black respondents flagged per 100,000</text>
            <text x="126" y="310" class="small">under FedAvg, against the composition-matched centralised control</text>
            <text x="48" y="340" class="small">The reversal holds at every screening capacity from 1% to 50%, for all five federated strategies.</text>
          </svg>
        )}

        {/* ============ COULD IT READ THE ANSWER: one model, two readings ============ */}
        {slug === "could-it-read-the-answer" && (
          <svg class="hf-svg" viewBox="0 0 720 380" role="img" aria-label="On the same 400 MMLU responses one model scores 0.013 under a strict pipeline and 0.938 when the answer is read wherever it appears.">
            <text x="24" y="34" class="eyebrow">ONE FRONTIER MODEL · THE SAME 400 MMLU RESPONSES · TWO WAYS TO READ THEM</text>
            <text x="24" y="72" class="lbl">The task’s strict pipeline</text>
            <rect x="24" y="82" width={Math.max(0.013 * 640, 3)} height="26" rx="2" class="fill-bad" />
            <text x={24 + 0.013 * 640 + 12} y="101" class="mono lbl fill-bad-t">0.013</text>
            <text x="24" y="142" class="lbl">The answer read wherever it appears</text>
            <rect x="24" y="152" width={0.938 * 640} height="26" rx="2" class="fill-signal" />
            <text x={24 + 0.938 * 640 - 10} y="171" class="mono lbl fill-paper-t" text-anchor="end">0.938</text>
            <line x1="24" y1="194" x2="664" y2="194" class="stroke-hairS" />
            {[0, 0.25, 0.5, 0.75, 1].map((t) => (
              <text x={24 + t * 640} y="210" class="mono tiny muted" text-anchor={t === 0 ? "start" : t === 1 ? "end" : "middle"}>{t}</text>
            ))}

            <text x="24" y="250" class="eyebrow">ACROSS THE HARNESS AND PUBLISHED GENERATIONS</text>
            <text x="24" y="276" class="small">Generative tasks that score a format mismatch as wrong</text>
            <rect x="24" y="286" width="300" height="14" rx="2" class="fill-recessed" />
            <rect x="24" y="286" width={0.649 * 300} height="14" rx="2" class="fill-signal" />
            <text x="24" y="322" class="mono mini">2,936 of 4,524 (64.9%)</text>

            <text x="384" y="276" class="small">Hidden parse-failure rate across 28 models</text>
            <line x1="384" y1="293" x2="684" y2="293" class="stroke-hairS" />
            <line x1={384 + 0.04 * 300} y1="293" x2={384 + 0.999 * 300} y2="293" class="stroke-bad" stroke-width="6" stroke-linecap="round" />
            <text x="384" y="322" class="mono mini">4% to 99.9%</text>

            <text x="24" y="360" class="small">A judge that never saw the gold answer confirms 97 of 99 recovered answers.</text>
          </svg>
        )}

        {/* ============ INDIAFINBENCH: the scoring rule reorders the board ============ */}
        {slug === "indiafinbench" && (
          <svg class="hf-svg" viewBox="0 0 720 380" role="img" aria-label="Strict accuracy spans 75.12 to 89.66 percent and judge-only accuracy 87.19 to 94.83 percent; DeepSeek-R1-Distill-Llama-70B ranks last under strict scoring and ties for first under the composite regime.">
            <text x="24" y="34" class="eyebrow">SAME 12 MODELS · SAME ANSWERS · TWO SCORING RULES</text>
            <text x="40" y="80" class="mini">Strict string matching</text>
            <rect x={40 + 5.12 * 11.333} y="90" width={(89.66 - 75.12) * 11.333} height="24" rx="3" class="fill-hairS" />
            <text x={40 + 5.12 * 11.333 - 6} y="107" class="mono tiny" text-anchor="end">75.12%</text>
            <text x={40 + 19.66 * 11.333 + 6} y="107" class="mono tiny">89.66%</text>
            <circle cx={40 + 5.12 * 11.333} cy="102" r="6" class="fill-bad stroke-raised" stroke-width="2" />
            <text x="40" y="150" class="mini">Judge from an unrelated model family</text>
            <rect x={40 + 17.19 * 11.333} y="160" width={(94.83 - 87.19) * 11.333} height="24" rx="3" class="fill-signal" />
            <text x={40 + 17.19 * 11.333 - 6} y="177" class="mono tiny" text-anchor="end">87.19%</text>
            <text x={40 + 24.83 * 11.333 + 6} y="177" class="mono tiny">94.83%</text>
            <line x1="40" y1="206" x2="380" y2="206" class="stroke-hairS" />
            {[70, 80, 90, 100].map((t) => (
              <g>
                <line x1={40 + (t - 70) * 11.333} y1="202" x2={40 + (t - 70) * 11.333} y2="210" class="stroke-hairS" />
                <text x={40 + (t - 70) * 11.333} y="226" class="mono tiny muted" text-anchor="middle">{t}%</text>
              </g>
            ))}
            <text x="40" y="250" class="tiny muted">Bands: the accuracy range across the twelve models.</text>

            <text x="440" y="34" class="eyebrow">ONE MODEL, TWO RANKINGS</text>
            <text x="460" y="66" class="mini" text-anchor="middle">Strict</text>
            <text x="620" y="66" class="mini" text-anchor="middle">Composite</text>
            <line x1="460" y1="80" x2="460" y2="244" class="stroke-hairS" />
            <line x1="620" y1="80" x2="620" y2="244" class="stroke-hairS" />
            {Array.from({ length: 12 }, (_, r) => (
              <g>
                <line x1="455" y1={80 + r * 14.909} x2="465" y2={80 + r * 14.909} class="stroke-hair" />
                <line x1="615" y1={80 + r * 14.909} x2="625" y2={80 + r * 14.909} class="stroke-hair" />
              </g>
            ))}
            <line x1="460" y1="244" x2="620" y2="80" class="stroke-signal" stroke-width="2.5" />
            <circle cx="460" cy="244" r="6" class="fill-bad" />
            <circle cx="620" cy="80" r="6" class="fill-signal" />
            <text x="448" y="248" class="mono mini fill-bad-t" text-anchor="end">12th</text>
            <text x="632" y="84" class="mono mini fill-signal-t">tied 1st</text>
            <text x="540" y="272" class="mini" text-anchor="middle">DeepSeek-R1-Distill-Llama-70B</text>
            <text x="540" y="292" class="small" text-anchor="middle">the judge reclassifies 93.9% of</text>
            <text x="540" y="310" class="small" text-anchor="middle">its strict errors as correct</text>

            <line x1="24" y1="326" x2="696" y2="326" class="stroke-hair" />
            <text x="24" y="348" class="small">Rank correlation, strict against judge-only: ρ = −0.273 (p = 0.39).</text>
            <text x="24" y="368" class="small">148 of 406 items are answered identically by all twelve models, separating no pair.</text>
          </svg>
        )}

        {/* ============ DIABETES: external validation as an X-ray ============ */}
        {slug === "diabetes-external-validation" && (
          <svg class="hf-svg" viewBox="0 0 720 380" role="img" aria-label="Internal AUC 0.794 falls to 0.717 on external validation; adults over 60 reach only 0.607.">
            <text x="24" y="34" class="eyebrow">THE MODEL LOOKS HEALTHY</text>
            <rect x="24" y="60" width="150" height="70" rx="8" class="fill-raised stroke-ink" />
            <text x="99" y="90" class="lbl" text-anchor="middle">Diabetes model</text>
            <text x="99" y="112" class="mono small muted" text-anchor="middle">XGBoost</text>
            <path d="M174 95 H232" class="arrow" marker-end="url(#hf-ar)" />
            <rect x="236" y="60" width="150" height="70" rx="8" class="fill-vwash stroke-verified" />
            <text x="311" y="88" class="lbl fill-verified-t" text-anchor="middle">Internal ✓</text>
            <text x="311" y="112" class="mono lbl fill-verified-t" text-anchor="middle">AUC 0.794</text>
            <text x="24" y="188" class="eyebrow fill-signal-t">UNTIL EXTERNAL VALIDATION LOOKS CLOSER</text>
            <circle cx="120" cy="270" r="48" class="fill-none stroke-signal" stroke-width="2.5" />
            <line x1="154" y1="304" x2="177" y2="327" class="stroke-signal" stroke-width="4" stroke-linecap="round" />
            <text x="120" y="266" class="mono tiny" text-anchor="middle">1,285,783</text>
            <text x="120" y="282" class="mini muted" text-anchor="middle">BRFSS</text>
            <path d="M186 270 H228" class="arrow" marker-end="url(#hf-ar)" />
            {[
              { y: 232, label: "Adults 60 and over", val: "AUC 0.607 · gap 0.135", w: 250, cls: "bad" },
              { y: 268, label: "Overall", val: "0.717 · −9.7%", w: 165, cls: "warn" },
              { y: 304, label: "Obese", val: "0.698 · gap 0.037", w: 95, cls: "mild" },
              { y: 340, label: "Calibration", val: "Brier 0.123 · overestimates risk", w: 130, cls: "info" },
            ].map((r) => (
              <g>
                <text x="242" y={r.y - 4} class="mini">{r.label}</text>
                <rect x="242" y={r.y} width={r.w} height="10" rx="3" class={`sev sev-${r.cls}`} />
                <text x={242 + r.w + 8} y={r.y + 9} class="mono tiny muted">{r.val}</text>
              </g>
            ))}
          </svg>
        )}

        {/* ============ TRUSTSHIFT: size of shift is not the diagnosis ============ */}
        {slug === "trustshift" && (
          <svg class="hf-svg" viewBox="0 0 720 390" role="img" aria-label="A lending model under measured shift improves in ranking while a mental-health text model at comparable shift loses up to 0.39 AUC; an intrusion detector falls from 0.998 to 0.68 AUC on unseen attack mechanisms; recalibration fixes calibration but not discrimination.">
            <text x="24" y="34" class="eyebrow">FOUR REAL DEPLOYMENT SHIFTS · ONE AUDIT PROTOCOL</text>
            <rect x="24" y="52" width="316" height="118" rx="8" class="fill-raised stroke-hairS" />
            <text x="44" y="80" class="lbl">Mortgage lending</text>
            <text x="44" y="98" class="mono tiny muted">domain-classifier AUC up to 0.80</text>
            <text x="44" y="134" class="lbl fill-verified-t">↑ Ranking improves</text>
            <text x="44" y="156" class="small">operating point within 0.02 (macro)</text>
            <text x="360" y="116" class="mono tiny muted" text-anchor="middle">vs</text>
            <rect x="380" y="52" width="316" height="118" rx="8" class="fill-raised stroke-bad" />
            <text x="400" y="80" class="lbl">Mental-health text</text>
            <text x="400" y="98" class="mono tiny muted">shift of comparable magnitude</text>
            <text x="400" y="134" class="lbl fill-bad-t">↓ Loses up to 0.39 AUC</text>
            <text x="400" y="156" class="small">Kaggle to Reddit and Twitter</text>

            <text x="24" y="206" class="eyebrow">NETWORK INTRUSION · ATTACK MECHANISMS ABSENT FROM TRAINING</text>
            <text x="24" y="234" class="mini">In-domain</text>
            <rect x="140" y="223" width={0.998 * 500} height="14" rx="2" class="fill-ink" />
            <text x={140 + 0.998 * 500 + 8} y="235" class="mono mini">0.998</text>
            <text x="24" y="262" class="mini">New mechanisms</text>
            <rect x="140" y="251" width={0.68 * 500} height="14" rx="2" class="fill-bad" />
            <text x={140 + 0.68 * 500 + 8} y="263" class="mono mini fill-bad-t">0.68</text>

            <rect x="24" y="288" width="672" height="86" rx="8" class="fill-recessed" />
            <text x="44" y="312" class="eyebrow">POST-HOC RECALIBRATION, EVERY DOMAIN</text>
            <text x="44" y="338" class="small fill-verified-t">✓ Calibration error falls by one to two orders of magnitude</text>
            <text x="44" y="360" class="small fill-bad-t">✗ Discrimination and subgroup reliability are not restored</text>
          </svg>
        )}

        {/* ============ CONFIDENTLY WRONG: through chance, not towards it ============ */}
        {slug === "confidently-wrong" && (
          <svg class="hf-svg" viewBox="0 0 720 390" role="img" aria-label="108 of 240 cross-network evaluations score below ROC-AUC 0.5; the worst is 0.0697, which is 0.9303 if the score is negated; 11 of 12 testbed pairs fail at the ranking.">
            <text x="24" y="34" class="eyebrow">ROC-AUC OF DETECTORS MOVED TO A NEW NETWORK</text>
            <text x="360" y="52" class="mono tiny fill-signal-t" text-anchor="middle">negate the score and the same detector ranks well</text>
            <rect x="40" y="96" width="320" height="54" class="fill-awash" />
            <path d={`M ${ax(0.0697)} 140 Q 360 22 ${ax(0.9303)} 140`} class="fill-none stroke-signal" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#hf-ar-s)" />
            <line x1="40" y1="150" x2="680" y2="150" class="stroke-ink" />
            <line x1="360" y1="90" x2="360" y2="158" class="stroke-ink" stroke-dasharray="3 3" />
            <circle cx={ax(0.0697)} cy="150" r="6" class="fill-bad" />
            <circle cx={ax(0.9303)} cy="150" r="6" class="fill-raised stroke-signal" stroke-width="2" />
            <text x={ax(0.0697)} y="174" class="mono mini fill-bad-t" text-anchor="middle">0.0697</text>
            <text x={ax(0.9303)} y="174" class="mono mini fill-signal-t" text-anchor="middle">0.9303</text>
            <text x="360" y="174" class="mono tiny" text-anchor="middle">0.5</text>
            <text x="44" y="196" class="small fill-bad-t">below chance: attacks ranked under benign traffic</text>
            <text x="676" y="196" class="small muted" text-anchor="end">above chance</text>

            <text x="40" y="238" class="eyebrow">108 OF 240 RUN-LEVEL EVALUATIONS SCORE BELOW 0.5</text>
            {evals.map((e) => (
              <rect x={e.x} y={e.y} width="8" height="8" class={e.bad ? "cell-bad" : "cell"} />
            ))}

            <text x="40" y="316" class="eyebrow">11 OF 12 TESTBED PAIRS FAIL AT THE RANKING</text>
            {Array.from({ length: 12 }, (_, k) => (
              <rect x={40 + k * 24} y="328" width="18" height="18" rx="2" class={k < 11 ? "cell-bad" : "cell cell-open"} />
            ))}
            <text x="40" y="370" class="tiny muted">The open square: the one pair where recalibration can help.</text>

            <text x="420" y="316" class="eyebrow">TEN LABELLED TARGET FLOWS</text>
            <text x="420" y="342" class="small">median macro-F1, no adaptation: <tspan class="mono">0.3919</tspan></text>
            <text x="420" y="364" class="small">after retraining on them: <tspan class="mono fill-signal-t">0.7253</tspan></text>
          </svg>
        )}

        {/* ============ SCORER PARTIAL IDENTIFICATION: audit width vs sampling width ============ */}
        {slug === "scorer-partial-identification" && (
          <svg class="hf-svg" viewBox="0 0 720 370" role="img" aria-label="The median identification width is 6.10 times the sampling width across 120 comparable pairs; every ratio is above one, the smallest 2.15.">
            <text x="24" y="34" class="eyebrow">WHAT SETS THE WIDTH OF A BENCHMARK COMPARISON?</text>
            <text x="24" y="72" class="lbl">Sampling width</text>
            <rect x="24" y="82" width="90" height="24" rx="2" class="fill-hairS" />
            <text x="124" y="100" class="mono lbl">1×</text>
            <text x="24" y="142" class="lbl">Identification width, from the audited scorer</text>
            <rect x="24" y="152" width={6.1 * 90} height="24" rx="2" class="fill-signal" />
            <text x={24 + 6.1 * 90 + 10} y="170" class="mono lbl fill-signal-t">6.10×</text>
            <text x="24" y="202" class="small">For the median pair among the 120 comparable model pairs on MATH-Hard.</text>

            <text x="24" y="240" class="eyebrow">EVERY ONE OF THE 120 RATIOS IS ABOVE 1×</text>
            <line x1="24" y1="270" x2="664" y2="270" class="stroke-hairS" />
            {Array.from({ length: 9 }, (_, k) => (
              <g>
                <line x1={24 + k * 80} y1="266" x2={24 + k * 80} y2="274" class="stroke-hairS" />
                <text x={24 + k * 80} y="294" class="mono tiny muted" text-anchor="middle">{k}×</text>
              </g>
            ))}
            <line x1="104" y1="254" x2="104" y2="280" class="stroke-ink" stroke-dasharray="3 3" />
            <text x="98" y="258" class="tiny muted" text-anchor="end">equal widths</text>
            <circle cx={24 + 2.15 * 80} cy="270" r="5" class="fill-raised stroke-signal" stroke-width="2" />
            <text x={24 + 2.15 * 80} y="256" class="mono tiny" text-anchor="middle">min 2.15×</text>
            <circle cx={24 + 5.74 * 80} cy="270" r="4" class="fill-raised stroke-signalDeep" stroke-width="2" />
            <text x={24 + 5.74 * 80} y="312" class="mono tiny" text-anchor="end">5.74× self-consistency check</text>
            <circle cx={24 + 6.1 * 80} cy="270" r="6" class="fill-signal" />
            <text x={24 + 6.1 * 80} y="256" class="mono tiny fill-signal-t" text-anchor="middle">median 6.10×</text>

            <rect x="24" y="326" width="672" height="36" rx="6" class="fill-recessed" />
            <text x="40" y="349" class="small">The harness’s two live scorers disagree on 3.63% of 22,508 responses (95% CI 3.39% to 3.88%).</text>
          </svg>
        )}

        {/* ============ MORTGAGE DISPARITIES: inside the institution ============ */}
        {slug === "mortgage-disparities" && (
          <svg class="hf-svg" viewBox="0 0 720 380" role="img" aria-label="74.6% of a 14.95 point approval gap sits within lenders; boundaries widen it by 2.0 and 1.5 points.">
            <text x="24" y="34" class="eyebrow">42M APPLICATIONS · RAW GAP 14.95 PP · WHERE DOES IT LIVE?</text>
            <text x="70" y="150" class="lbl" text-anchor="middle">Applicant</text>
            <path d="M120 175 H172" class="arrow" marker-end="url(#hf-ar)" />
            <rect x="180" y="70" width="360" height="240" rx="12" class="fill-recessed stroke-ink" />
            <text x="360" y="98" class="eyebrow" text-anchor="middle">INSIDE ONE LENDER</text>
            <rect x="214" y="120" width="292" height="120" rx="8" class="fill-signal" />
            <text x="360" y="168" class="big-num fill-paper-t" text-anchor="middle">74.6%</text>
            <text x="360" y="196" class="lbl fill-paper-t" text-anchor="middle">of the gap is within-lender</text>
            <text x="360" y="222" class="mono tiny fill-paper-t" text-anchor="middle">rising 66.8% → 78.3% (2020 → 2024)</text>
            <text x="360" y="280" class="small muted" text-anchor="middle">only a minority sits between institutions</text>
            <text x="24" y="344" class="eyebrow fill-signal-t">BOUNDARIES WIDEN IT</text>
            <rect x="220" y="326" width="150" height="30" rx="6" class="fill-raised stroke-hair" />
            <text x="295" y="345" class="mono tiny" text-anchor="middle">+2.0 pp at 80% LTV</text>
            <rect x="384" y="326" width="176" height="30" rx="6" class="fill-raised stroke-hair" />
            <text x="472" y="345" class="mono tiny" text-anchor="middle">+1.5 pp · 2022 tightening</text>
            <text x="626" y="180" class="mono tiny muted" text-anchor="middle">68% unexplained</text>
            <text x="626" y="196" class="mono tiny muted" text-anchor="middle">by observables</text>
          </svg>
        )}

        {/* ============ CATE: the average hides the distribution ============ */}
        {slug === "who-bears-the-burden" && (
          <svg class="hf-svg" viewBox="0 0 720 360" role="img" aria-label="A pooled differential of minus 9.39 points hides a wide distribution: 90.7% of Black applicants face a negative estimated effect, minus 14.79 under manual underwriting against minus 6.17 under automated systems.">
            <defs>
              <clipPath id="hf-pen"><rect x="0" y="0" width="560" height="360" /></clipPath>
            </defs>
            <text x="24" y="32" class="eyebrow">A HEADLINE REPORTS ONE AVERAGE</text>
            <rect x="32" y="120" width="130" height="62" rx="8" class="fill-recessed stroke-ink" />
            <text x="97" y="150" class="big-num" text-anchor="middle">−9.39</text>
            <text x="97" y="170" class="mono tiny muted" text-anchor="middle">pp, the average</text>
            <path d="M166 151 H218" class="arrow" marker-end="url(#hf-ar)" />
            <text x="168" y="174" class="mono tiny fill-signal-t">but it spreads</text>
            <line x1="230" y1="250" x2="700" y2="250" class="stroke-hair" />
            <path d="M230 250 C330 250 400 92 457 90 C514 92 600 250 700 250 Z" class="dist-fill" />
            <path d="M230 250 C330 250 400 92 457 90 C514 92 600 250 700 250 Z" class="dist-pen" clip-path="url(#hf-pen)" />
            <path d="M230 250 C330 250 400 92 457 90 C514 92 600 250 700 250" class="fill-none stroke-signalDeep" stroke-width="2" />
            <line x1="560" y1="80" x2="560" y2="250" class="stroke-ink" stroke-dasharray="4 3" />
            <text x="560" y="268" class="mono tiny" text-anchor="middle">0 · no penalty</text>
            <text x="236" y="150" class="lbl fill-signalDeep-t">90.7% penalised</text>
            <line x1="292" y1="158" x2="330" y2="224" class="stroke-signalDeep" stroke-width="1" />
            <line x1="397" y1="70" x2="397" y2="250" class="stroke-bad" stroke-width="1.6" />
            <text x="391" y="66" class="mono tiny fill-bad-t" text-anchor="end">manual −14.79</text>
            <line x1="492" y1="70" x2="492" y2="250" class="stroke-signal" stroke-width="1.6" />
            <text x="498" y="66" class="mono tiny fill-signal-t">automated −6.17</text>
            <text x="700" y="286" class="tiny muted" text-anchor="end">shape schematic · values from the paper</text>
            <text x="24" y="326" class="small">The underwriting channel, not the applicant, explains who lands where (CATE SD 8.47 pp).</text>
          </svg>
        )}

        {/* ============ ICGDF: the deployment gate ============ */}
        {slug === "when-the-gate-stays-closed" && (
          <svg class="hf-svg" viewBox="0 0 720 400" role="img" aria-label="Both stages of the deployment gate fail, so the gate stays closed in all 12 folds even though the model is well calibrated.">
            <text x="360" y="34" class="eyebrow" text-anchor="middle">CAN THE MODEL PROVE PREDICTIVE SKILL BEFORE IT TRADES?</text>
            <rect x="120" y="58" width="220" height="52" rx="8" class="fill-raised stroke-bad" />
            <text x="230" y="80" class="lbl" text-anchor="middle">Stage 1 · HAC t-test</text>
            <text x="230" y="99" class="mono small fill-bad-t" text-anchor="middle">✗  t = −0.09</text>
            <rect x="380" y="58" width="220" height="52" rx="8" class="fill-raised stroke-bad" />
            <text x="490" y="80" class="lbl" text-anchor="middle">Stage 2 · Permutation</text>
            <text x="490" y="99" class="mono small fill-bad-t" text-anchor="middle">✗  inside the null</text>
            <path d="M230 110 V146" class="arrow" marker-end="url(#hf-ar)" />
            <path d="M490 110 V146" class="arrow" marker-end="url(#hf-ar)" />
            <rect x="250" y="152" width="220" height="76" rx="6" class="fill-recessed stroke-ink" stroke-width="2" />
            {[280, 310, 340, 370, 400, 430].map((x) => (
              <line x1={x} y1="158" x2={x} y2="222" class="stroke-ink" stroke-width="3" />
            ))}
            <text x="360" y="248" class="gate-lbl" text-anchor="middle">GATE CLOSED · 0 OF 12 FOLDS</text>
            <rect x="234" y="266" width="252" height="42" rx="8" class="fill-ink" />
            <text x="360" y="293" class="verdict fill-paper-t" text-anchor="middle">DO NOT DEPLOY</text>
            <text x="24" y="340" class="eyebrow fill-signal-t">THE TWIST</text>
            <text x="24" y="362" class="small">ECE below 0.025: the model is well calibrated, and still has no measurable skill</text>
            <text x="24" y="382" class="small">(mean IC −0.0005, p = 0.536). Calibration is not deployment readiness.</text>
          </svg>
        )}
      </div>

      <svg class="hf-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
          <marker id="hf-ar" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 Z" class="fill-hairS" /></marker>
          <marker id="hf-ar-s" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 Z" class="fill-signal" /></marker>
        </defs>
      </svg>

      <p class="hf-hint label-mono">Swipe to see the whole figure</p>
      <figcaption class="hf-cap">{caption}</figcaption>
    </figure>
  )
}

<style>
  .hf {
    margin: 0;
    padding: var(--space-8);
