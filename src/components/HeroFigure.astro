    .hf-hint { display: block; }
    .hf-cap { text-align: left; }
  }

  /* --- SVG text roles --- */
  .hf :global(text) { font-family: var(--font-sans); }
  .hf :global(.eyebrow) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    fill: var(--ink-3);
  }
  .hf :global(.lbl) { font-size: 14px; font-weight: 600; fill: var(--ink); }
