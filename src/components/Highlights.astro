---
import { publications } from "../data/research";

// Discovery-first highlights, immediately after the hero: the reader meets
// three claims before any section, each with the one number that carries it.
const bySlug = (slug: string) => publications.find((p) => p.slug === slug)!;

const highlights = [
  {
    tag: "Benchmark evaluation",
    claim: "Most orderings on a published LLM leaderboard <em>cannot be separated</em> once the scorer’s blind spots are counted.",
    stat: "357 of 378 orderings not identified",
    paper: bySlug("benchmark-accuracy-not-identified"),
  },
  {
    tag: "Fairness",
    claim: "A subgroup AUC gap <em>narrows</em> while the screening decision flags fewer Black respondents.",
    stat: "542 fewer flagged per 100,000",
    paper: bySlug("subgroup-fairness-reversal"),
  },
  {
    tag: "Clinical AI",
    claim: "External validation on over 1.28 million records exposes an <em>age-shaped</em> failure that internal validation hides.",
    stat: "AUC 0.794 → 0.717, and 0.607 over 60",
    paper: bySlug("diabetes-external-validation"),
  },
];
---

<section class="highlights" aria-label="Research highlights">
  <div class="container container--wide">
    <h2 class="label-mono hl-eyebrow" data-reveal>Three findings, one program</h2>
    <ul class="hl-grid">
      {
        highlights.map((h) => (
          <li class="hl-card" data-reveal>
            <a href={`/research/${h.paper.slug}/`} class="hl-link">
              <div class="hl-top">
                <span class="label-mono hl-tag">{h.tag}</span>
                <span class={`status status--${h.paper.statusKind}`}>
                  {h.paper.statusKind === "published" ? "Published" : h.paper.status}
                </span>
              </div>
              <p class="hl-claim" set:html={h.claim} />
              <p class="hl-stat">{h.stat}</p>
              <span class="hl-more ui-sans">Read the paper →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-block: var(--space-16) var(--space-24);
    border-bottom: var(--rule);
  }

  .hl-eyebrow {
    color: var(--signal);
    display: block;
    margin-bottom: var(--space-8);
  }

  .hl-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .hl-card {
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    background: var(--paper-raised);
    transition:
      box-shadow var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out),
      transform var(--dur-med) var(--ease-out);
  }

  .hl-card:hover {
    box-shadow: var(--shadow-2);
    border-color: var(--signal);
    transform: translateY(-3px);
  }

  .hl-link {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .hl-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .hl-tag { color: var(--signal); }

  .hl-claim {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: 0;
    max-width: none;
  }

  .hl-claim :global(em) {
    font-style: italic;
    color: var(--signal);
  }

  .hl-stat {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
    padding-top: var(--space-4);
    border-top: var(--rule);
    font-variant-numeric: tabular-nums;
  }

  .hl-more {
    color: var(--signal);
    font-size: var(--text-sm);
  }

  @media (max-width: 980px) {
    .hl-claim { font-size: var(--text-md); }
  }

  @media (max-width: 820px) {
    .hl-grid { grid-template-columns: 1fr; }
  }
</style>
