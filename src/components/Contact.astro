---
import { identity, publications, service } from "../data/research";

const count = (kind: string) => publications.filter((p) => p.statusKind === kind).length;
---

<section class="contact container" id="contact">
  <div class="contact-grid">
    <div data-reveal>
      <p class="label-mono section-eyebrow">About</p>
      <p class="about-text">
        I am <strong>{identity.name}</strong>, an AI researcher studying whether
        machine learning results mean what they claim, from scoring rules in LLM
        benchmarks to fairness at the decision threshold and clinical external
        validation.{` ${publications.length} papers and manuscripts so far: ${count("published")} published, ${count("review")} under review. `}I
        am applying to MS programs in Computer Science and Machine Learning for
        Fall 2027.
      </p>
      <dl class="about-facts ui-sans">
        <div>
          <dt class="label-mono">Education</dt>
          <dd>
            {identity.degree}<br />
            {identity.institution} · {identity.expected}
          </dd>
        </div>
        <div>
          <dt class="label-mono">Service</dt>
          <dd>
            {service.map((s) => (
              <span class="fact-line">{s.role}, {s.venue}</span>
            ))}
          </dd>
        </div>
      </dl>
    </div>
    <div data-reveal>
      <p class="label-mono section-eyebrow">Contact</p>
      <ul class="contact-links">
        <li>
          <a href={`mailto:${identity.email}`} class="contact-link">
            <span class="label-mono">Email</span>
            <span class="ui-sans contact-email" translate="no">{identity.email}</span>
          </a>
        </li>
        {
          identity.links.map((l) => (
            <li>
              <a href={l.href} class="contact-link">
                <span class="label-mono">{l.label}</span>
                <span class="ui-sans contact-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="portfolio-btn ui-sans" href="https://rajveer-code.github.io/">
        Engineering portfolio ↗
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-wordmark-wrap" aria-hidden="true">
    <span class="footer-wordmark">Rajveer Singh&nbsp;Pall</span>
  </div>
  <div class="container footer-inner">
    <span class="label-mono">© 2026 {identity.name}</span>
    <span class="label-mono footer-thesis">
      Accuracy is not enough. Audit the decision.
    </span>
  </div>
</footer>

<style>
  .contact {
    padding-block: var(--space-section);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-16);
  }

  .section-eyebrow {
    color: var(--signal);
    display: block;
    margin-bottom: var(--space-8);
  }

  .about-text {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .about-text strong {
    color: var(--ink);
    font-weight: 500;
  }

  .about-facts {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: var(--rule);
    max-width: 46ch;
  }

  .about-facts div {
    display: grid;
    gap: var(--space-2);
  }

  .about-facts dt { color: var(--signal); }

  .about-facts dd {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .fact-line { display: block; }

  .contact-links {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 2.75rem;
    padding-block: var(--space-4);
    border-bottom: var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-link:hover { color: var(--signal); }
  .contact-link:hover .label-mono { color: var(--signal); }

  .contact-email { overflow-wrap: anywhere; text-align: right; }

  .contact-arrow { color: var(--ink-3); }

  .portfolio-btn {
    display: inline-block;
    margin-top: var(--space-6);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-2);
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .portfolio-btn:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  .footer {
    border-top: var(--rule);
    background: var(--paper-recessed);
    overflow: hidden;
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-wordmark-wrap {
    padding-top: var(--space-16);
    margin-bottom: calc(-0.18 * clamp(4rem, 13vw, 12rem));
  }

  .footer-wordmark {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 13vw, 12rem);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--hairline-strong);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .footer-thesis { font-style: italic; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-12); }
    .footer-inner { flex-direction: column; gap: var(--space-2); }
  }
</style>
