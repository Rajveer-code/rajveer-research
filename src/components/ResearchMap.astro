---
import { publications, THEME_LABELS, type Theme } from "../data/research";

interface Node {
  theme: Theme | null;
  label: string;
  x: number;
  y: number;
}

const CX = 450;
const CY = 260;

// Nine themes on an ellipse (rx 342, ry 204) around the question, clockwise
// from the top, neighbours chosen so shared papers sit next to each other.
const ring: Theme[] = [
  "evaluation",
  "nlp-llm",
  "finance",
  "security",
  "deployment",
  "healthcare",
  "privacy",
  "fairness",
  "causal",
];

const nodes: Node[] = ring.map((theme, k) => {
  const angle = ((-90 + (360 / ring.length) * k) * Math.PI) / 180;
  return {
    theme,
    label: THEME_LABELS[theme],
    x: Math.round(CX + 342 * Math.cos(angle)),
    y: Math.round(CY + 204 * Math.sin(angle)),
  };
});

const countFor = (theme: Theme) =>
  publications.filter((p) => p.themes.includes(theme)).length;

const cross: [number, number][] = [
  [2, 4], // finance and deployment: the deployment gate
  [3, 5], // security and healthcare: TrustShift
  [5, 7], // healthcare and fairness: external validation, screening
  [7, 0], // fairness and evaluation: what a metric identifies
  [8, 2], // causal inference and finance: lending
];

// Papers per theme — drives the interactive detail panel.
const themeKeys = Object.keys(THEME_LABELS) as Theme[];
const papersByTheme = Object.fromEntries(
  themeKeys.map((t) => [
    t,
    publications
      .filter((p) => p.themes.includes(t))
      .sort((a, b) => a.order - b.order),
  ]),
) as Record<Theme, typeof publications>;
---

<section class="map-section" id="map">
  <div class="container">
    <p class="label-mono section-eyebrow" data-reveal>Research map</p>
    <h2 class="section-title" data-reveal>
      One ecosystem, <em>not</em> a list of results
    </h2>

    <p class="map-hint label-mono" data-reveal>
      Hover or tap a theme to see its papers
    </p>
    <figure class="map-figure" data-reveal data-map-root>
      <svg
        class="map-svg"
        viewBox="20 24 860 472"
        role="img"
        aria-labelledby="map-desc"
        data-map
      >
        <desc id="map-desc">
          Network map: one research question at the center, whether reported
          results mean what they claim, connected to benchmark evaluation, NLP
          and LLMs, financial ML, network security, deployment shift, healthcare
          AI, privacy and federated learning, fairness, and causal inference.
        </desc>

        {/* edges: center → nodes */}
        {
          nodes.map((n, i) => (
            <line
              class="edge"
              x1={CX}
              y1={CY}
              x2={n.x}
              y2={n.y}
              data-edge
              data-edge-idx={i}
            />
          ))
        }
        {/* cross edges */}
        {
          cross.map(([a, b]) => (
            <line
              class="edge edge--cross"
              x1={nodes[a].x}
              y1={nodes[a].y}
              x2={nodes[b].x}
              y2={nodes[b].y}
              data-edge
            />
          ))
        }

        {/* satellite nodes — interactive */}
        {
          nodes.map((n, i) => (
            <g
              class="node"
              data-node
              data-node-idx={i}
              data-theme={n.theme}
              tabindex="0"
              role="button"
              aria-label={`${n.label}: ${n.theme ? countFor(n.theme) : 0} works`}
            >
              <circle cx={n.x} cy={n.y} r="16" class="node-hit" />
              <circle cx={n.x} cy={n.y} r="7" class="node-dot" />
              <text x={n.x} y={n.y - 18} class="node-label" text-anchor="middle">
                {n.label}
              </text>
              {n.theme && (
                <text x={n.x} y={n.y + 30} class="node-count" text-anchor="middle">
                  {countFor(n.theme)} {countFor(n.theme) === 1 ? "work" : "works"}
                </text>
              )}
            </g>
          ))
        }

        {/* center: the question; links to the flagship */}
        <a class="center" data-node href="#flagship" aria-label="The question that binds every theme: see the flagship result">
          <circle cx={CX} cy={CY} r="80" class="center-pulse" />
          <circle cx={CX} cy={CY} r="80" class="center-ring" />
          <text x={CX} y={CY - 26} class="center-thesis" text-anchor="middle">
            Does the result
          </text>
          <text x={CX} y={CY - 2} class="center-thesis" text-anchor="middle">
            <tspan class="center-thesis--em">mean</tspan> what
          </text>
          <text x={CX} y={CY + 22} class="center-thesis" text-anchor="middle">
            it claims?
          </text>
          <text x={CX} y={CY + 46} class="center-sub" text-anchor="middle">
            see the flagship →
          </text>
        </a>
      </svg>

      {/* phones: the same themes as a list, since the map's labels would be too small to read */}
      <ul class="map-chips" aria-label="Research themes">
        {
          nodes.map((n) => (
            <li>
              <button type="button" class="map-chip ui-sans" data-theme={n.theme} aria-pressed="false">
                <span>{n.label}</span>
                <span class="label-mono map-chip-count">{n.theme ? countFor(n.theme) : 0}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <aside class="map-panel" data-map-panel aria-live="polite">
        <div class="panel-view" data-panel-default>
          <span class="label-mono panel-eyebrow">The question</span>
          <h3 class="panel-title">One question binds the program</h3>
          <p class="panel-text">
            Every theme around it asks whether a reported number, be it a
            benchmark score, a subgroup AUC, a validation result or a
            backtest,{" "}<em>supports the decision</em>{" "}made with it. Hover or
            tap a theme to see its papers.
          </p>
          <a class="panel-cta ui-sans" href="#flagship">See the flagship result →</a>
        </div>
        {
          themeKeys.map((t) => (
            <div class="panel-view" data-panel-theme={t} hidden>
              <span class="label-mono panel-eyebrow">{THEME_LABELS[t]}</span>
              <ul class="panel-list">
                {papersByTheme[t].map((p) => (
                  <li>
                    <a href={`/research/${p.slug}/`} class="panel-paper">
                      <span class="panel-paper-title">{p.shortTitle}</span>
                      <span class="ui-sans panel-paper-status">{p.status}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </aside>
    </figure>
  </div>
</section>

<script>
  function initResearchMap() {
    const root = document.querySelector<HTMLElement>("[data-map-root]");
    if (!root || root.dataset.wired) return;
    root.dataset.wired = "1";

    const views = root.querySelectorAll<HTMLElement>(".panel-view");
    const nodes = root.querySelectorAll<HTMLElement>("[data-theme]");
    let locked: string | null = null;

    const show = (theme: string | null) => {
      views.forEach((v) => {
        v.hidden = theme
          ? v.dataset.panelTheme !== theme
          : !("panelDefault" in v.dataset);
      });
    };

    nodes.forEach((node) => {
      const theme = node.dataset.theme ?? null;
      node.addEventListener("mouseenter", () => { if (!locked) show(theme); });
      node.addEventListener("mouseleave", () => { if (!locked) show(null); });
      node.addEventListener("focus", () => { if (!locked) show(theme); });
      node.addEventListener("blur", () => { if (!locked) show(null); });
      node.addEventListener("click", () => {
        locked = locked === theme ? null : theme;
        show(locked);
        nodes.forEach((n) => {
          if (n.tagName === "BUTTON") n.setAttribute("aria-pressed", String(n.dataset.theme === locked));
        });
      });
      node.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          (node as HTMLElement).click();
        }
      });
    });
  }
  document.addEventListener("astro:page-load", initResearchMap);
</script>

<style>
  .map-section {
    padding-block: var(--space-section);
    border-bottom: var(--rule);
  }

  .section-eyebrow {
    color: var(--signal);
    display: block;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-weight: 460;
    max-width: 22ch;
    margin-bottom: var(--space-16);
  }

  .section-title em {
    font-style: italic;
    color: var(--signal);
  }

  .map-hint {
    color: var(--ink-3);
    margin-bottom: var(--space-6);
  }

  .map-figure {
    margin: 0;
  }

  .map-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    margin-inline: auto;
    max-width: 60rem;
  }

  /* --- interactive nodes --- */
  .node { cursor: pointer; outline: none; }
  .node-hit { fill: transparent; }
  .node:focus-visible .node-dot,
  .node:hover .node-dot {
    fill: var(--signal);
  }
  .node:focus-visible .node-label { fill: var(--signal); }
  .node:focus-visible .node-hit {
    stroke: var(--signal);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .center { cursor: pointer; }

  .center-thesis {
    font-family: var(--font-serif);
    font-size: 19px;
    fill: var(--signal-deep);
    font-weight: 500;
  }
  .center-thesis--em { font-style: italic; fill: var(--signal); }

  .center-sub {
    font-family: var(--font-sans);
    font-size: 12.5px;
    fill: var(--signal-deep);
  }
  .center:hover .center-ring { fill: color-mix(in srgb, var(--signal) 16%, var(--paper)); }

  /* --- detail panel (full-width strip below the map) --- */
  .map-panel {
    min-height: 9rem;
    margin-top: var(--space-8);
    padding: var(--space-8);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    background: var(--paper-raised);
  }

  .panel-eyebrow { color: var(--signal); display: block; margin-bottom: var(--space-4); }

  .panel-title {
    font-size: var(--text-lg);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .panel-text { color: var(--ink-2); max-width: 70ch; }
  .panel-text em { font-style: italic; color: var(--signal); }

  .panel-cta {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--signal);
    text-decoration: none;
  }
  .panel-cta:hover { text-decoration: underline; }

  .panel-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-2) var(--space-8);
  }

  .panel-paper {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .panel-paper:hover .panel-paper-title { color: var(--signal); }

  .panel-paper-title {
    font-size: var(--text-base);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .panel-paper-status { font-size: var(--text-xs); color: var(--ink-3); }

  @media (max-width: 860px) {
    .map-figure { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  .edge {
    stroke: var(--hairline-strong);
    stroke-width: 1;
  }

  .edge--cross {
    stroke-dasharray: 4 5;
    stroke: var(--hairline-strong);
  }

  .node-dot {
    fill: var(--paper);
    stroke: var(--signal);
    stroke-width: 2;
  }

  .node-label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
  }

  .node-count {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    fill: var(--ink-3);
  }

  .center-ring {
    fill: var(--signal-wash);
    stroke: var(--signal);
    stroke-width: 1.5;
  }

  .center-pulse {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1;
    transform-origin: 450px 260px;
    animation: map-pulse 4.5s var(--ease-out) infinite;
  }

  @keyframes map-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70%, 100% { transform: scale(1.55); opacity: 0; }
  }

  /* hover spotlight: dim everything, light the hovered spoke */
  .edge, .node { transition: opacity var(--dur-med) var(--ease-out); }

  .map-svg.is-hover :is(.edge, .node):not(.is-hot) { opacity: 0.22; }
  .map-svg.is-hover .center { opacity: 1; }

  .edge.is-hot {
    stroke: var(--signal);
    stroke-width: 1.5;
  }

  .node.is-hot .node-dot { fill: var(--signal-wash); }

  .center-dot { fill: var(--signal); }

  .center-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    fill: var(--signal-deep);
  }

  .map-caption {
    margin-top: var(--space-8);
    max-width: 60ch;
  }

  /* phone list of themes (the SVG map is hidden below 640px) */
  .map-chips {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .map-chip {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-2);
    border: 0;
    border-bottom: var(--rule);
    background: transparent;
    color: var(--ink);
    text-align: left;
    touch-action: manipulation;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .map-chip[aria-pressed="true"] {
    background: var(--signal-wash);
    color: var(--signal-deep);
  }

  .map-chip-count { color: var(--signal); }

  @media (max-width: 640px) {
    .map-svg { display: none; }
    .map-chips { display: block; }
    .map-panel { margin-top: var(--space-6); padding: var(--space-6); }
  }
</style>
