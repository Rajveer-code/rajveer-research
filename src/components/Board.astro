---
/**
 * The flagship evidence: a published MATH-Hard leaderboard, shown as reported
 * and as identified. Data: src/data/leaderboard.json, regenerated by
 * scripts/build-leaderboard.mjs from the public flipbudget-results dataset
 * (the build asserts all 378 public pairs reproduce exactly).
 */
import data from "../data/leaderboard.json";

interface Props {
  id?: string;
  limit?: number;
}

const { id = "board", limit = 10 } = Astro.props;
const total = data.models.length;
const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
const range = (a: number, b: number) => (a === b ? `${a}` : `${a}–${b}`);
const points = (x: number) => (x * 100).toFixed(1);
const ticks = [0, 25, 50, 75, 100];
---

<figure class="board" id={id} data-board data-mode="identified">
  <div class="board-head">
    <div>
      <h3 class="label-mono board-title" id={`${id}-title`}>MATH-Hard · {total} published models</h3>
      <p class="board-readout" aria-live="polite">
        <span data-readout="all"
          ><strong class="num">{data.counts.notIdentified} of {data.counts.pairs}</strong> pairwise orderings are not
          identified</span
        >
        <span data-readout="row" hidden></span>
      </p>
    </div>
    <div class="switch ui-sans" role="radiogroup" aria-label="Show each model as">
      <button type="button" role="radio" aria-checked="false" data-set="reported">Reported</button>
      <button type="button" role="radio" aria-checked="true" data-set="identified">Identified</button>
    </div>
  </div>

  <div class="board-scroll">
    <table class="board-table ui-sans" aria-labelledby={`${id}-title`}>
      <thead>
        <tr>
          <th scope="col" class="c-rank">Rank</th>
          <th scope="col" class="c-model">Model</th>
          <th scope="col" class="c-score">Score</th>
          <th scope="col" class="c-plot">
            <span class="visually-hidden">Range consistent with the evidence</span>
            <span class="axis" aria-hidden="true">
              {ticks.map((t) => <span style={`--t:${t}%`}>{t}</span>)}
            </span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          data.models.map((m, i) => (
            <tr
              tabindex={i === 0 ? 0 : -1}
              class:list={[{ "is-extra": i >= limit }]}
              data-order={m.order}
              data-name={m.name}
              data-inseparable={m.inseparable.join(" ")}
              style={`--i:${Math.min(i, limit)}`}
            >
              <td class="c-rank num">
                <span class="rank-stack">
                  <span class="rank rank-reported">{m.reportedRank}</span>
                  <span class="rank rank-identified">{range(m.rankMin, m.rankMax)}</span>
                </span>
              </td>
              <td class="c-model" translate="no">
                <span class="org">{m.org}</span>
                <span class="name">{m.name}</span>
              </td>
              <td class="c-score num">{pct(m.score)}</td>
              <td class="c-plot">
                <span class="track" aria-hidden="true">
                  <span
                    class="whisker"
                    style={`--lo:${points(m.lower)}%;--hi:${points(m.upper)}%;--origin:${(((m.score - m.lower) / (m.upper - m.lower)) * 100).toFixed(1)}%`}
                  />
                  <span class="point" style={`--pt:${points(m.score)}%`} />
                </span>
                <span class="visually-hidden">
                  {`Consistent with ${pct(m.lower)} to ${pct(m.upper)}; rank ${range(m.rankMin, m.rankMax)} once identified.`}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <figcaption class="board-foot ui-sans">
    <p>
      {
        `Each range runs from the published score minus the measured false-credit margin (${points(data.margins.falseCredit)} points) to the score plus that model’s unreadable-response rate and the confidently-wrong margin (${points(data.margins.confidentlyWrong)} points). Margins are 95% upper bounds from a human audit. Models whose ranges overlap cannot be ordered. Hover or focus a row to see who it is tied with.`
      }
    </p>
    <p class="board-links">
      <a href="/research/benchmark-accuracy-not-identified/">About the paper</a>
      <a href={data.source.dataset}>Data on Hugging Face ↗</a>
      <button type="button" class="board-more" hidden>Show all {total} models</button>
    </p>
  </figcaption>
</figure>

<script>
  function initBoards() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const board of document.querySelectorAll<HTMLElement>("[data-board]")) {
      if (board.dataset.wired) continue;
      board.dataset.wired = "1";

      const radios = [...board.querySelectorAll<HTMLButtonElement>("[data-set]")];
      const rows = [...board.querySelectorAll<HTMLTableRowElement>("tbody tr")];
      const readAll = board.querySelector<HTMLElement>('[data-readout="all"]')!;
      const readRow = board.querySelector<HTMLElement>('[data-readout="row"]')!;
      const more = board.querySelector<HTMLButtonElement>(".board-more")!;
      let touched = false;

      const clearTie = () => {
        board.classList.remove("has-tie");
        rows.forEach((r) => r.classList.remove("is-tied", "is-focus"));
        readRow.hidden = true;
        readAll.hidden = false;
      };

      const setMode = (mode: string) => {
        board.dataset.mode = mode;
        radios.forEach((r) => r.setAttribute("aria-checked", String(r.dataset.set === mode)));
        if (mode === "reported") clearTie();
      };

      const showTie = (row: HTMLTableRowElement) => {
        if (board.dataset.mode !== "identified") return;
        const tied = new Set((row.dataset.inseparable ?? "").split(" ").filter(Boolean));
        board.classList.add("has-tie");
        rows.forEach((r) => {
          r.classList.toggle("is-tied", tied.has(r.dataset.order ?? ""));
          r.classList.toggle("is-focus", r === row);
        });
        readRow.textContent = `${row.dataset.name} cannot be separated from ${tied.size} of ${rows.length - 1} models`;
        readRow.hidden = false;
        readAll.hidden = true;
      };

      radios.forEach((radio) =>
        radio.addEventListener("click", () => {
          touched = true;
          setMode(radio.dataset.set ?? "identified");
        }),
      );

      // Arrow keys move between the two radios, as a radio group should.
      board.querySelector(".switch")?.addEventListener("keydown", (event) => {
        const e = event as KeyboardEvent;
        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.key)) return;
        e.preventDefault();
        const next = radios.find((r) => r.getAttribute("aria-checked") !== "true");
        if (!next) return;
        touched = true;
        setMode(next.dataset.set ?? "identified");
        next.focus();
      });

      const visibleRows = () => rows.filter((r) => r.offsetParent !== null);

      rows.forEach((row) => {
        row.addEventListener("pointerenter", () => showTie(row));
        row.addEventListener("focus", () => showTie(row));
        row.addEventListener("keydown", (e) => {
          const list = visibleRows();
          const at = list.indexOf(row);
          let target: HTMLTableRowElement | undefined;
          if (e.key === "ArrowDown") target = list[at + 1];
          if (e.key === "ArrowUp") target = list[at - 1];
          if (e.key === "Home") target = list[0];
          if (e.key === "End") target = list[list.length - 1];
          if (e.key === "Escape") {
            clearTie();
            return;
          }
          if (!target) return;
          e.preventDefault();
          row.tabIndex = -1;
          target.tabIndex = 0;
          target.focus();
        });
      });
      board.querySelector("tbody")?.addEventListener("pointerleave", clearTie);

      if (rows.some((r) => r.classList.contains("is-extra"))) {
        board.classList.add("is-truncated");
        more.hidden = false;
        more.addEventListener("click", () => {
          board.classList.remove("is-truncated");
          more.hidden = true;
          // the section grew: let scroll-linked motion re-measure
          window.dispatchEvent(new Event("resize"));
        });
      }

      // The authored moment: the board arrives ranked, then shows what the evidence supports.
      if (!reduce) {
        setMode("reported");
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            observer.disconnect();
            window.setTimeout(() => {
              if (!touched) setMode("identified");
            }, 1100);
          },
          { threshold: 0.45 },
        );
        observer.observe(board);
      }
    }
  }

  initBoards();
  document.addEventListener("astro:page-load", initBoards);
</script>

<style>
  .board {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: var(--space-8);
    background: var(--paper-raised);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    min-width: 0;
  }

  .board-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }

  .board-title {
    font-weight: 400;
    color: var(--signal);
  }

  .board-readout {
    margin-top: var(--space-2);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    min-height: 2.7em;
    max-width: 32ch;
  }

  .board-readout .num {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--signal);
    letter-spacing: -0.02em;
  }

  .switch {
    display: inline-flex;
    padding: 3px;
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    background: var(--paper-recessed);
  }

  .switch button {
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-1);
    background: transparent;
    color: var(--ink-2);
    font-weight: 560;
    touch-action: manipulation;
    transition:
      background-color var(--dur-med) var(--ease-out),
      color var(--dur-med) var(--ease-out);
  }

  .switch button:hover { color: var(--signal); }

  .switch button[aria-checked="true"] {
    background: var(--ink);
    color: var(--paper);
  }

  .board[data-mode="identified"] .switch button[data-set="identified"] {
    background: var(--signal);
    color: var(--paper);
  }

  .board-scroll {
    overflow-x: auto;
    margin-inline: calc(-1 * var(--space-2));
  }

  .board-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  th {
    padding: 0 var(--space-2) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: left;
    border-bottom: var(--rule-strong);
  }

  td {
    height: 2.25rem;
    padding: 0 var(--space-2);
    vertical-align: middle;
    border-bottom: var(--rule);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .c-rank { width: 4.5rem; }

  .c-score {
    width: 4.75rem;
    text-align: right;
  }

  th.c-score { text-align: right; }

  .c-plot { width: 38%; }

  .c-model {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .org { color: var(--ink-3); }

  .org:not(:empty)::after { content: "/"; }

  .name { font-weight: 540; color: var(--ink); }

  /* Rank: both forms share one grid cell and cross-fade. */
  .rank-stack {
    display: grid;
    align-items: center;
  }

  .rank {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-med) var(--ease-out),
      transform var(--dur-med) var(--ease-out);
  }

  .board[data-mode="reported"] .rank-identified,
  .board[data-mode="identified"] .rank-reported {
    opacity: 0;
    transform: translateY(6px);
  }

  .rank-identified { color: var(--signal-deep); }

  /* Plot column: one axis, interval whiskers, a point at the published score. */
  .axis {
    position: relative;
    display: block;
    height: 1.2em;
    letter-spacing: 0;
  }

  .axis span {
    position: absolute;
    left: var(--t);
    transform: translateX(-50%);
    font-variant-numeric: tabular-nums;
  }

  .axis span:first-child { transform: none; }

  .axis span:last-child { transform: translateX(-100%); }

  .track {
    position: relative;
    display: block;
    height: 18px;
    background: linear-gradient(to right, var(--hairline) 1px, transparent 1px) 0 0 / 25% 100%;
    box-shadow: inset -1px 0 0 var(--hairline);
  }

  .whisker {
    position: absolute;
    top: 50%;
    left: var(--lo);
    width: calc(var(--hi) - var(--lo));
    height: 2px;
    margin-top: -1px;
    background: var(--ink);
    transform-origin: var(--origin) 50%;
    transition: transform var(--dur-slow) var(--ease-out);
    transition-delay: calc(var(--i) * 26ms);
  }

  .whisker::before,
  .whisker::after {
    content: "";
    position: absolute;
    top: -4px;
    width: 1.5px;
    height: 10px;
    background: var(--ink);
  }

  .whisker::before { left: 0; }

  .whisker::after { right: 0; }

  .board[data-mode="reported"] .whisker {
    transform: scaleX(0.001);
    transition-delay: 0ms;
  }

  .point {
    position: absolute;
    top: 50%;
    left: var(--pt);
    width: 8px;
    height: 8px;
    border: 2px solid var(--paper-raised);
    border-radius: 50%;
    background: var(--signal);
    transform: translate(-50%, -50%);
    box-sizing: content-box;
  }

  /* Tie band: rows that cannot be separated from the one in focus. */
  tbody tr { outline: none; }

  tbody tr:focus-visible td {
    box-shadow:
      inset 0 2px 0 var(--signal),
      inset 0 -2px 0 var(--signal);
  }

  .board.has-tie tbody tr:not(.is-tied, .is-focus) td { opacity: 0.35; }

  tbody tr.is-tied td { background: var(--signal-wash); }

  tbody tr.is-focus td {
    background: var(--signal);
    color: var(--paper);
  }

  tbody tr.is-focus :is(.org, .name, .rank-identified) { color: inherit; }

  tbody tr.is-focus .whisker,
  tbody tr.is-focus .whisker::before,
  tbody tr.is-focus .whisker::after { background: var(--paper); }

  tbody tr.is-focus .point {
    background: var(--paper);
    border-color: var(--signal);
  }

  .board.is-truncated .is-extra { display: none; }

  .board-foot {
    display: grid;
    gap: var(--space-4);
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .board-foot p { max-width: 80ch; }

  .board-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
  }

  .board-links a { text-decoration: none; }

  .board-links a:hover { text-decoration: underline; }

  .board-more {
    min-height: 2.5rem;
    margin-left: auto;
    padding: 0 var(--space-4);
    border: var(--rule-strong);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    touch-action: manipulation;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .board-more:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .rank { white-space: nowrap; }

  @media (max-width: 640px) {
    .board { padding: var(--space-4); }

    th,
    td { padding-inline: var(--space-1); }

    td.num { font-size: var(--text-xs); }

    .org { display: none; }

    td.c-model {
      white-space: normal;
      overflow-wrap: anywhere;
      line-height: 1.2;
      padding-block: var(--space-2);
    }

    .name { font-size: var(--text-xs); }

    .c-rank { width: 3.25rem; }

    .c-score { width: 3.75rem; }

    .c-plot { width: 34%; }

    .axis span:not(:first-child, :last-child) { display: none; }

    .board-more { margin-left: 0; }
  }
</style>
